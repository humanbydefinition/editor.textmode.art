NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/synth_textmode
ADMIN_API_TOKEN=replace_me
# Version string users must confirm in publish consent payload
PUBLISH_CONSENT_POLICY_VERSION=2026-02-08
# Client-side policy version shown in publish dialog consent text
VITE_PUBLISH_CONSENT_POLICY_VERSION=2026-02-08
# Client-side Cloudflare Turnstile site key used by publish dialog
VITE_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key
# Anti-spam challenge signing secret (at least 32 chars; required in production)
ANTI_SPAM_SECRET=replace_with_a_long_random_secret_value
# Cloudflare Turnstile server-side secret key (required in production)
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
# Optional: override Turnstile verify endpoint
# TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
# Anti-spam proof-of-work difficulty (leading zero bits, 8-24)
ANTI_SPAM_POW_DIFFICULTY=14
# Challenge validity duration in seconds
ANTI_SPAM_CHALLENGE_TTL_SECONDS=180
# Global anti-spam guards (no per-user/IP tracking)
ANTI_SPAM_MAX_CHALLENGES_PER_MINUTE=600
ANTI_SPAM_MAX_SUBMISSIONS_PER_MINUTE=60
ANTI_SPAM_MAX_PENDING_REQUESTS=5000
ANTI_SPAM_IDEMPOTENCY_TTL_SECONDS=600
# Optional: override where static assets live (defaults to ../../dist)
# STATIC_DIR=/absolute/path/to/dist
# Optional: base URL for canonical links
# PUBLIC_BASE_URL=https://synth.textmode.art
# Optional: internal base URL used by screenshot capture requests
# SCREENSHOT_BASE_URL=http://127.0.0.1:3000
# Optional: persistent storage directory for generated screenshots
# SCREENSHOT_STORAGE_DIR=/data/storage
# Required in production: token required by /_internal/preview/:slug for screenshot rendering
# SCREENSHOT_PREVIEW_TOKEN=replace_with_at_least_16_random_characters
