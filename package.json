{
	"name": "editor.textmode.art",
	"version": "1.0.0",
	"license": "AGPL-3.0",
	"author": "humanbydefinition <hello@textmode.art> (https://code.textmode.art)",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "npm run extract-types && vite --host --port 5180",
		"build": "npm run extract-types && tsc && vite build && tsx scripts/gallery/social-pages.ts",
		"preview": "vite preview",
		"check": "npm run check:format && npm run lint && npm run lint:md && npm run check:types && npm run test:coverage && npm run test:og && npm run build",
		"check:types": "npm run extract-types && tsc --noEmit",
		"lint": "eslint .",
		"lint:md": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --config package.json --configPointer /markdownlint-cli2 --fix",
		"test": "npm run extract-types && vitest run",
		"test:watch": "npm run extract-types && vitest",
		"test:coverage": "npm run extract-types && vitest run --coverage",
		"format": "prettier --write . --ignore-unknown",
		"check:format": "prettier --check . --ignore-unknown",
		"extract-types": "tsx scripts/editor-types/cli.ts",
		"playwright:install": "playwright install chromium --no-shell",
		"generate:og": "tsx scripts/og/cli.ts gallery",
		"generate:og:site": "tsx scripts/og/cli.ts site",
		"test:og": "playwright test --config scripts/og/playwright.config.ts",
		"prepare": "npm run extract-types && install-git-hooks"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slider": "^1.3.6",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.13",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@shaderfrog/glsl-parser": "^7.0.1",
		"@textmode/runner-client": "^0.5.0",
		"acorn": "^8.17.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.27.0",
		"lz-string": "^1.5.0",
		"monaco-editor": "^0.56.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.4.0",
		"tailwindcss-animate": "^1.0.7",
		"zustand": "^5.0.10"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@textmode/commitlint-config": "^0.1.1",
		"@textmode/markdownlint-config": "^0.1.1",
		"@textmode/og": "^0.1.0",
		"@textmode/prettier-config": "^0.1.0",
		"@textmode/tooling-scripts": "^0.3.9",
		"@textmode/tsconfig": "^0.1.0",
		"@textmode/vitest-config": "^0.2.0",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"eslint": "^10.6.0",
		"globals": "^17.8.0",
		"jsdom": "^29.1.1",
		"lint-staged": "^17.0.8",
		"markdownlint-cli2": "^0.23.0",
		"@playwright/test": "1.61.1",
		"prettier": "^3.9.4",
		"tailwindcss": "^4.1.10",
		"textmode.export.js": "^1.5.2",
		"textmode.figlet.js": "^1.0.2",
		"textmode.filters.js": "^1.2.2",
		"textmode.js": "^0.17.0",
		"textmode.synth.js": "^1.7.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0",
		"vite": "^8.1.3",
		"vitest": "^4.1.10"
	},
	"prettier": "@textmode/prettier-config",
	"commitlint": {
		"extends": [
			"@textmode/commitlint-config"
		]
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"markdownlint-cli2": {
		"globs": [
			"**/*.md"
		],
		"ignores": [
			"node_modules/**",
			"dist/**",
			"sketches/**"
		],
		"fix": false,
		"outputFormatters": [
			[
				"markdownlint-cli2-formatter-default"
			]
		],
		"config": {
			"extends": "@textmode/markdownlint-config"
		}
	}
}
