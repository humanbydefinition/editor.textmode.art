{
    "name": "@synth.textmode.art/server",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "npm run prisma:migrate:deploy && tsx watch src/index.ts",
        "lint": "eslint .",
        "build": "npm run prisma:generate && tsc",
        "check-types": "npm run prisma:generate && tsc --noEmit",
        "start": "node dist/index.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "playwright:install": "playwright install chromium",
        "screenshots:regenerate": "tsx scripts/regenerate-screenshots.ts"
    },
    "dependencies": {
        "@fastify/cors": "^10.0.0",
        "@fastify/helmet": "^12.0.1",
        "@fastify/static": "^8.0.0",
        "@prisma/adapter-pg": "^7.4.0",
        "@prisma/client": "^7.4.0",
        "@synth.textmode.art/contracts": "file:../contracts",
        "discord.js": "^14.25.1",
        "dotenv": "^16.4.7",
        "fastify": "^5.2.1",
        "playwright": "^1.58.2"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "prisma": "^7.4.0",
        "tsx": "^4.19.2",
        "typescript": "~5.9.3"
    }
}
