{
	"name": "editor.textmode.art",
	"version": "1.0.0",
	"license": "AGPL-3.0-or-later",
	"author": "humanbydefinition <hello@textmode.art> (https://code.textmode.art)",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.0.0",
			"onFail": "warn"
		},
		"packageManager": {
			"name": "npm",
			"version": ">=10.0.0",
			"onFail": "warn"
		}
	},
	"scripts": {
		"dev": "npm run extract-types && vite --host --port 5180",
		"build": "npm run extract-types && tsc && vite build && tsx scripts/gallery/social-pages.ts",
		"preview": "vite preview",
		"check": "npm run check:format && npm run lint && npm run lint:md && npm run check:types && npm run test:coverage && npm run test:og && npm run build",
		"check:types": "npm run extract-types && tsc --noEmit",
		"lint": "textmode-lint lint .",
		"lint:md": "textmode-lint lint:markdown",
		"lint:md:fix": "textmode-lint lint:markdown --fix",
		"test": "npm run extract-types && vitest run",
		"test:watch": "npm run extract-types && vitest",
		"test:coverage": "npm run extract-types && vitest run --coverage",
		"format": "textmode-lint format",
		"check:format": "textmode-lint format:check",
		"extract-types": "tsx scripts/editor-types/cli.ts",
		"playwright:install": "playwright install chromium --no-shell",
		"generate:og": "tsx scripts/og/cli.ts gallery",
		"generate:og:site": "tsx scripts/og/cli.ts site",
		"test:og": "playwright test --config scripts/og/playwright.config.ts",
		"prepare": "npm run extract-types"
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-scroll-area": "^1.2.18",
		"@radix-ui/react-separator": "^1.1.15",
		"@radix-ui/react-slider": "^1.4.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-switch": "^1.3.7",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-tooltip": "^1.2.16",
		"@shaderfrog/glsl-parser": "^7.0.1",
		"@textmode/runner-client": "^0.5.0",
		"acorn": "^8.18.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.35.0",
		"lz-string": "^1.5.0",
		"monaco-editor": "^0.56.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss-animate": "^1.0.7",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@tailwindcss/vite": "^4.3.3",
		"@textmode/build": "^0.1.0",
		"@textmode/lint": "^0.1.1",
		"@textmode/og": "^0.1.0",
		"@textmode/tsconfig": "^0.2.1",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"jsdom": "^30.0.1",
		"tailwindcss": "^4.3.3",
		"textmode.export.js": "1.8.0",
		"textmode.figlet.js": "1.0.5",
		"textmode.filters.js": "1.2.5",
		"textmode.js": "0.18.0",
		"textmode.synth.js": "1.8.2",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"prettier": "@textmode/lint/prettier"
}
