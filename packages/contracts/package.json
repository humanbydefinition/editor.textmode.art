{
  "name": "@synth.textmode.art/contracts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "default": "./dist/share.js"
    },
    "./sketch": {
      "types": "./dist/sketch.d.ts",
      "default": "./dist/sketch.js"
    },
    "./contact": {
      "types": "./dist/contact.d.ts",
      "default": "./dist/contact.js"
    },
    "./runner/textmode": {
      "types": "./dist/runner/textmode.d.ts",
      "default": "./dist/runner/textmode.js"
    },
    "./runner/strudel": {
      "types": "./dist/runner/strudel.d.ts",
      "default": "./dist/runner/strudel.js"
    }
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
