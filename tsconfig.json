{
	"extends": "@textmode/tsconfig/typecheck.json",
	"compilerOptions": {
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "vite.config.ts", "scripts"],
	"exclude": ["node_modules", "dist"]
}
